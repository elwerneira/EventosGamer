# El script start-mysql.ps1 genera .env con contraseñas aleatorias si no existe.
# No copiar estas contraseñas de ejemplo a una base que se vaya a publicar.
MYSQL_PORT=3307
MYSQL_PASSWORD=CAMBIAR_CONTRASENA_MYSQL
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT
# El arranque agrega JWT_SECRET con 32 bytes aleatorios si falta; conserva .env entre reinicios.
