{
  "info": {
    "name": "GREEGAME Semana 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con cookies habilitadas. Crea un evento de prueba, agrega una foto, comentario y valoración y lo comparte dentro del sitio. Las escrituras requieren CSRF y los recursos privados JWT. Los enlaces sociales solo se generan: no publican mensajes automáticamente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "player2@eventos.test"
    },
    {
      "key": "password",
      "value": "GamerDemo2026!"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "mediaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Obtener CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/csrf",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);",
              "pm.test(\"Cookie CSRF presente\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"XSRF-TOKEN\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login sin CSRF rechazado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login con CSRF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({url:pm.variables.replaceIn(\"{{baseUrl}}/api/csrf\"),method:\"GET\"},(error,response)=>{",
              "  if(error || response.code !== 200) throw new Error(\"No se pudo obtener CSRF\");",
              "  const csrf=response.json();",
              "  pm.collectionVariables.set(\"csrfToken\",csrf.token);",
              "  pm.request.headers.upsert({key:csrf.headerName,value:csrf.token});",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"accessToken\",pm.response.json().accessToken);",
              "pm.test(\"JWT Bearer\",()=>pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\"));"
            ]
          }
        }
      ]
    },
