            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "20 Agregar fotografía",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/eventos/{{eventId}}/media",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "type": "file",
              "contentType": "image/png",
              "key": "file",
              "src": "postman/fixtures/s5-prueba.png"
            },
            {
              "type": "text",
              "value": "Fotografía de demostración GREEGAME",
              "key": "caption"
            }
          ]
        },
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({url:pm.variables.replaceIn(\"{{baseUrl}}/api/csrf\"),method:\"GET\"},(error,response)=>{",
              "  if(error || response.code !== 200) throw new Error(\"No se pudo obtener CSRF\");",
              "  const csrf=response.json();",
              "  pm.collectionVariables.set(\"csrfToken\",csrf.token);",
              "  pm.request.headers.upsert({key:csrf.headerName,value:csrf.token});",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"mediaId\",pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "21 Descargar fotografía privada",
      "request": {
        "method": "GET",
